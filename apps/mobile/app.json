{
  "expo": {
    "name": "Everbrilliant",
    "slug": "everbrilliant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.everbrilliant.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.everbrilliant.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "scheme": "everbrilliant",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-notifications",
        { "icon": "./assets/icon.png", "color": "#3b82f6" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
