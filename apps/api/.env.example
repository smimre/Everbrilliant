NODE_ENV=production
DATABASE_URL="postgresql://user:password@localhost:5432/everbrilliant"
REDIS_URL="redis://:password@localhost:6379"
JWT_SECRET=change-me-to-a-64-char-random-string
API_URL=https://yourdomain.com
WEB_URL=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com
PORT=3000

# Email (SMTP) — leave blank to disable (reset codes logged to console instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=EverBrilliant

# SMS (Kavenegar) — Iranian numbers (+98). Leave blank to disable.
# Get your API key from https://panel.kavenegar.com
KAVENEGAR_API_KEY=your-kavenegar-api-key
KAVENEGAR_SENDER=10004346
# Optional: Kavenegar registered template name for OTP messages
KAVENEGAR_OTP_TEMPLATE=

# WhatsApp Business (Meta Cloud API) — international numbers. Leave blank to disable.
# Get from https://developers.facebook.com → WhatsApp → API Setup
# Required templates: everbrilliant_welcome, everbrilliant_otp, everbrilliant_invoice, everbrilliant_request
WHATSAPP_TOKEN=your-meta-permanent-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
