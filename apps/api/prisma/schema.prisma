// ══════════════════════════════════════════════════════════════
// PHASE 12 — SaaS Extensions
// Added without breaking existing tables
// ══════════════════════════════════════════════════════════════

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
  WHITE_LABEL
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum UsageMetric {
  USERS
  REQUESTS
  INVOICES
  STORAGE_MB
  API_CALLS
  TENDERS
  CONNECTIONS
}

// ── Subscription Plans ────────────────────────────────────────
model SubscriptionPlan {
  id            String         @id @default(cuid())
  name          String         @unique
  nameFa        String?
  tier          PlanTier       @default(FREE)
  priceMonthly  BigInt         @default(0)
  priceAnnual   BigInt         @default(0)
  currency      String         @default("IRR")
  isPublic      Boolean        @default(true)
  isDefault     Boolean        @default(false)
  trialDays     Int            @default(14)
  features      Json
  limits        Json
  sortOrder     Int            @default(0)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

// ── Company Subscriptions ─────────────────────────────────────
model Subscription {
  id              String             @id @default(cuid())
  companyId       Int                @unique
  planId          String
  status          SubscriptionStatus @default(TRIALING)
  billingCycle    BillingCycle       @default(MONTHLY)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  autoRenew       Boolean            @default(true)
  customLimits    Json?
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  company         Company            @relation(fields: [companyId], references: [id])
  plan            SubscriptionPlan   @relation(fields: [planId], references: [id])
  payments        SubscriptionPayment[]
  usageRecords    UsageRecord[]

  @@index([companyId])
  @@index([status])
  @@map("subscriptions")
}

// ── Subscription Payments ─────────────────────────────────────
model SubscriptionPayment {
  id              String    @id @default(cuid())
  subscriptionId  String
  amount          BigInt
  currency        String    @default("IRR")
  period          String
  status          String    @default("pending")
  paidAt          DateTime?
  method          String?
  referenceNo     String?
  invoiceUrl      String?
  createdAt       DateTime  @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("subscription_payments")
}

// ── Usage Tracking ────────────────────────────────────────────
model UsageRecord {
  id              Int         @id @default(autoincrement())
  subscriptionId  String
  companyId       Int
  metric          UsageMetric
  value           Int
  period          String
  recordedAt      DateTime    @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId, metric, period])
  @@index([companyId, metric])
  @@map("usage_records")
}

// ── White-label Config ────────────────────────────────────────
model WhiteLabelConfig {
  id              Int      @id @default(autoincrement())
  companyId       Int      @unique
  appName         String   @default("Everbrilliant")
  appNameFa       String?
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("#3b82f6")
  secondaryColor  String   @default("#8b5cf6")
  domain          String?  @unique
  supportEmail    String?
  supportPhone    String?
  footerText      String?
  customCss       String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id])

  @@map("white_label_configs")
}

// ══════════════════════════════════════════════
// MANUFACTURING
// ══════════════════════════════════════════════

model BOMTemplate {
  id            String    @id @default(cuid())
  companyId     Int
  code          String
  product       String
  productFa     String?
  unit          String    @default("Pcs")
  description   String?
  laborMinutes  Int?
  overheadRate  Decimal?  @db.Decimal(10, 4)
  isActive      Boolean   @default(true)
  createdById   Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company       Company      @relation(fields: [companyId], references: [id])
  createdBy     User         @relation("BOMCreator", fields: [createdById], references: [id])
  items         BOMItem[]
  workOrders    WorkOrder[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("bom_templates")
}

model BOMItem {
  id              Int       @id @default(autoincrement())
  bomId           String
  materialCode    String
  material        String
  materialFa      String?
  qty             Decimal   @db.Decimal(15, 3)
  unit            String
  scrapFactor     Decimal   @db.Decimal(5, 4) @default(0)
  unitCostIRR     BigInt?
  notes           String?

  bom             BOMTemplate @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@map("bom_items")
}

model WorkOrder {
  id            String            @id @default(cuid())
  companyId     Int
  orderNo       String
  bomId         String?
  productName   String
  productNameFa String?
  qty           Decimal           @db.Decimal(15, 3)
  unit          String            @default("Pcs")
  startDate     DateTime?
  dueDate       DateTime
  status        WorkOrderStatus   @default(PLANNED)
  priority      WorkOrderPriority @default(NORMAL)
  progress      Int               @default(0)
  workcenter    String?
  estimatedCostIRR BigInt?
  actualCostIRR    BigInt?
  notes         String?
  completedAt   DateTime?
  createdById   Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company       Company           @relation(fields: [companyId], references: [id])
  bom           BOMTemplate?      @relation(fields: [bomId], references: [id])
  createdBy     User              @relation("WorkOrderCreator", fields: [createdById], references: [id])
  wipEntries    WIPEntry[]
  qcInspections QCInspection[]

  @@unique([companyId, orderNo])
  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@map("work_orders")
}

model RawMaterial {
  id              String    @id @default(cuid())
  companyId       Int
  code            String
  material        String
  materialFa      String?
  unit            String
  available       Decimal   @db.Decimal(15, 3) @default(0)
  required        Decimal   @db.Decimal(15, 3) @default(0)
  reorderPoint    Decimal   @db.Decimal(15, 3) @default(0)
  unitCostIRR     BigInt?
  supplier        String?
  dueDate         DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company         Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
  @@map("raw_materials")
}

model WIPEntry {
  id              Int       @id @default(autoincrement())
  workOrderId     String
  stage           String
  completedQty    Decimal   @db.Decimal(15, 3) @default(0)
  actualCostIRR   BigInt?
  note            String?
  recordedById    Int
  recordedAt      DateTime  @default(now())

  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  recordedBy      User      @relation("WIPRecorder", fields: [recordedById], references: [id])

  @@index([workOrderId])
  @@map("wip_entries")
}

model QCInspection {
  id              Int       @id @default(autoincrement())
  workOrderId     String
  companyId       Int
  inspectedQty    Decimal   @db.Decimal(15, 3)
  passedQty       Decimal   @db.Decimal(15, 3)
  failedQty       Decimal   @db.Decimal(15, 3) @default(0)
  result          QCResult  @default(PENDING)
  notes           String?
  defectCodes     String?
  inspectedById   Int
  inspectedAt     DateTime  @default(now())

  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inspectedBy     User      @relation("QCInspector", fields: [inspectedById], references: [id])

  @@index([workOrderId])
  @@index([companyId])
  @@map("qc_inspections")
}

// ══════════════════════════════════════════════
// CRM — DEALS
// ══════════════════════════════════════════════

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Deal {
  id               String    @id @default(cuid())
  companyId        Int
  partnerCompanyId Int?
  partnerName      String
  title            String
  titleFa          String?
  stage            DealStage @default(LEAD)
  valueIRR         BigInt?
  probability      Int       @default(50)
  closingDate      DateTime?
  ownerName        String?
  notes            String?
  lostReason       String?
  createdById      Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ownerCompany     Company   @relation("CompanyDeals", fields: [companyId], references: [id])
  createdBy        User      @relation("DealCreator", fields: [createdById], references: [id])

  @@index([companyId])
  @@index([stage])
  @@map("deals")
}

// ══════════════════════════════════════════════
// TRADING — COMPANY BLACKLIST
// ══════════════════════════════════════════════

enum BlacklistSeverity {
  LOW
  MEDIUM
  HIGH
}

enum BlacklistStatus {
  ACTIVE
  APPEALING
  EXPIRED
}

model CompanyBlacklist {
  id               Int               @id @default(autoincrement())
  ownerCompanyId   Int
  companyName      String
  companyCode      String?
  reason           String
  reasonFa         String?
  severity         BlacklistSeverity @default(MEDIUM)
  status           BlacklistStatus   @default(ACTIVE)
  tenderId         String?
  tenderTitle      String?
  addedById        Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  addedBy          User              @relation("BlacklistCreator", fields: [addedById], references: [id])

  @@index([ownerCompanyId])
  @@map("company_blacklist")
}

// ══════════════════════════════════════════════
// LOGISTICS MODULE
// ══════════════════════════════════════════════

model LogisticsShipment {
  id            String   @id @default(cuid())
  companyId     Int
  trackingCode  String   @unique
  cargo         String
  shipType      String   @default("domestic")
  status        String   @default("booked")
  origin        String
  destination   String
  weight        Decimal? @db.Decimal(12, 3)
  weightUnit    String   @default("تن")
  volume        Decimal? @db.Decimal(12, 3)
  cost          BigInt   @default(0)
  costPaid      Boolean  @default(false)
  sellerName    String?
  buyerName     String?
  waybillNo     String?
  hsCode        String?
  customsStatus String?
  customsNotes  String?
  insurer       String?
  insuranceAmt  BigInt?
  policyNo      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id])
  stages   LogisticsStage[]

  @@index([companyId])
  @@map("logistics_shipments")
}

model LogisticsStage {
  id         Int               @id @default(autoincrement())
  shipmentId String
  key        String
  label      String
  labelFa    String
  isDone     Boolean           @default(false)
  date       String?
  stageOrder Int               @default(0)

  shipment   LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("logistics_stages")
}

model LogisticsRateQuote {
  id        String   @id @default(cuid())
  companyId Int
  fromLoc   String
  toLoc     String
  mode      String   @default("Truck")
  rate      BigInt   @default(0)
  unit      String   @default("per load")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("logistics_rate_quotes")
}

model Message {
  id            String   @id @default(cuid())
  fromCompanyId Int
  toCompanyId   Int
  fromUserId    Int
  subject       String
  body          String
  type          String   @default("message")
  refId         String?
  refType       String?
  isRead        Boolean  @default(false)
  isStarred     Boolean  @default(false)
  createdAt     DateTime @default(now())

  fromCompany   Company  @relation("SentMessages",     fields: [fromCompanyId], references: [id])
  toCompany     Company  @relation("ReceivedMessages", fields: [toCompanyId],   references: [id])
  fromUser      User     @relation("MessageSender",    fields: [fromUserId],    references: [id])

  @@index([toCompanyId])
  @@index([fromCompanyId])
  @@map("messages")
}
