  updatedAt     DateTime      @updatedAt

  company       Company       @relation(fields: [companyId], references: [id])
  createdBy     User          @relation("MeetingCreator", fields: [createdById], references: [id])

  @@index([companyId])
  @@map("meetings")
}

model Task {
