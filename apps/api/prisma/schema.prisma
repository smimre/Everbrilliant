  @@index([date])
  @@map("journal_entries")
}

model JournalLine {
  id              Int           @id @default(autoincrement())
  entryId         String
  debitAccountId  Int?
  creditAccountId Int?
  debit           BigInt        @default(0)
  credit          BigInt        @default(0)
  description     String?

