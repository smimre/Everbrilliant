// ══════════════════════════════════════════════════════════════════════════
// EVERBRILLIANT — Production Database Schema
// PostgreSQL | Multi-tenant SaaS ERP
// Version: 2.0
// ══════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum RequestStatus {
  DRAFT
  PENDING
  QUOTED
  APPROVED
  PAID
  ISSUED
  REJECTED
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ContractStatus {
  DRAFT
  UNDER_REVIEW
  READY_TO_SIGN
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum TenderType {
  AUCTION
  TENDER
}

enum TenderStatus {
  DRAFT
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum InvoiceType {
  TYPE1
  TYPE2
  TYPE3
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  DISPUTED
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  ONLINE
  LETTER_OF_CREDIT
}

enum JournalStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LetterType {
  INCOMING
  OUTGOING
  INTERNAL
}

enum LetterPriority {
  NORMAL
  URGENT
  CONFIDENTIAL
  SECRET
}

enum LetterStatus {
  DRAFT
  SENT
  RECEIVED
  ARCHIVED
}

enum WorkflowType {
  LEAVE
  ADVANCE
  PURCHASE
  TRAVEL
  OVERTIME
  RESIGNATION
  PROMOTION
  OTHER
}

enum WorkflowStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalAction {
  PENDING
  APPROVED
  REJECTED
  DELEGATED
}

enum MeetingType {
  ONLINE
  IN_PERSON
  HYBRID
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ShipmentStatus {
  BOOKED
  PICKED_UP
  IN_TRANSIT
  CUSTOMS
  DELIVERED
  RETURNED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  REQUEST
  APPROVAL
  PAYMENT
  CONTRACT
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  APPROVE
  REJECT
  SIGN
  PRINT
}

enum WorkOrderStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  QC
  COMPLETED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum QCResult {
  PENDING
  PASS
  FAIL
  CONDITIONAL
}

// ══════════════════════════════════════════════
// MULTI-TENANT: COMPANIES
// ══════════════════════════════════════════════

model Company {
  id              Int       @id @default(autoincrement())
  name            String
  legalName       String?
  nationalId      String?   @unique
  economicCode    String?   @unique
  regNo           String?
  postalCode      String?
  address         String?
  city            String?
  province        String?
  country         String    @default("Iran")
  phone           String?
  fax             String?
  email           String?
  website         String?
  logo            String?
  stamp           String?
  vatRegistered   Boolean   @default(true)
  vatRate         Int       @default(10)
  plan            Plan      @default(FREE)
  planExpiresAt   DateTime?
  maxUsers        Int       @default(5)
  isActive        Boolean   @default(true)
  isVerified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  users            User[]
  roles            Role[]          @relation("CompanyRoles")
  buyerRequests    TradeRequest[]  @relation("BuyerCompany")
  sellerRequests   TradeRequest[]  @relation("SellerCompany")
  buyerContracts   Contract[]      @relation("BuyerContract")
  sellerContracts  Contract[]      @relation("SellerContract")
  sellerInvoices   Invoice[]       @relation("SellerInvoice")
  buyerInvoices    Invoice[]       @relation("BuyerInvoice")
  tenders          Tender[]
  inventory        InventoryItem[]
  letters          Letter[]
  meetings         Meeting[]
  employees        Employee[]
  accounts         Account[]
  journalEntries   JournalEntry[]
  budgets          Budget[]
  connectionsA     CompanyConnection[] @relation("CompanyA")
  connectionsB     CompanyConnection[] @relation("CompanyB")
  sentMessages     Message[]           @relation("SentMessages")
  receivedMessages Message[]           @relation("ReceivedMessages")
  inviteCodes      InviteCode[]
  apiKeys          ApiKey[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  products         Product[]
  priceLists       PriceList[]
  workOrders       WorkOrder[]
  bomTemplates     BOMTemplate[]
  rawMaterials     RawMaterial[]
  deals            Deal[]            @relation("CompanyDeals")
  logisticsShipments LogisticsShipment[]
  rateQuotes         LogisticsRateQuote[]

  @@index([nationalId])
  @@index([economicCode])
  subscription     Subscription?
  whiteLabelConfig WhiteLabelConfig?

  @@map("companies")
}

// ══════════════════════════════════════════════
// USERS & AUTH
// ══════════════════════════════════════════════

model User {
  id              Int       @id @default(autoincrement())
  name            String
  phone           String    @unique
  email           String?   @unique
  password        String
  avatar          String?
  staffCode       String?
  jobTitle        String?
  department      String?
  companyId       Int
  roleId          Int
  isActive        Boolean   @default(true)
  isCompanyAdmin  Boolean   @default(false)
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  lastLoginAt     DateTime?
  lastLoginIp     String?
  passwordChangedAt DateTime?
  resetToken      String?
  resetTokenExpiry DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  company         Company          @relation(fields: [companyId], references: [id])
  role            Role             @relation(fields: [roleId], references: [id])
  sessions        Session[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  createdRequests TradeRequest[]
  approvals       Approval[]
  letters         Letter[]
  workflowReqs    WorkflowRequest[]
  meetings        Meeting[]        @relation("MeetingCreator")
  journalEntries  JournalEntry[]
  workOrdersCreated WorkOrder[]    @relation("WorkOrderCreator")
  bomsCreated       BOMTemplate[]  @relation("BOMCreator")
  wipEntries        WIPEntry[]     @relation("WIPRecorder")
  qcInspections     QCInspection[] @relation("QCInspector")
  dealsCreated      Deal[]         @relation("DealCreator")
  blacklistEntries  CompanyBlacklist[] @relation("BlacklistCreator")
  messagesSent      Message[]      @relation("MessageSender")

  @@index([companyId])
  @@index([phone])
  @@map("users")
}

model Session {
  id          Int       @id @default(autoincrement())
  userId      Int
  token       String    @unique
  refreshToken String?  @unique
  expiresAt   DateTime
  ipAddress   String?
  userAgent   String?
  isRevoked   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// ══════════════════════════════════════════════
// RBAC: ROLES & PERMISSIONS
// ══════════════════════════════════════════════

model Role {
  id          Int       @id @default(autoincrement())
  name        String
  label       String
  labelFa     String?
  labelAr     String?
  companyId   Int?
  isSystem    Boolean   @default(false)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  company     Company?  @relation("CompanyRoles", fields: [companyId], references: [id])
  users       User[]
  permissions RolePermission[]

  @@unique([name, companyId])
  @@map("roles")
}

model Permission {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  label       String
  labelFa     String?
  module      String
  description String?
  createdAt   DateTime  @default(now())

  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  grantedAt    DateTime  @default(now())
  grantedBy    Int?

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ══════════════════════════════════════════════
// PRODUCTS CATALOG
// ══════════════════════════════════════════════

model Product {
  id              String    @id @default(cuid())
  companyId       Int
  name            String
  nameEn          String?
  nameAr          String?
  description     String?
  category        String?
  subCategory     String?
  hsCode          String?
  unit            String    @default("ton")
  defaultCurrency String    @default("IRR")
  defaultPrice    Decimal?  @db.Decimal(20, 2)
  minOrderQty     Decimal?  @db.Decimal(15, 3)
  maxOrderQty     Decimal?  @db.Decimal(15, 3)
  leadTimeDays    Int?
  origin          String?
  specs           Json?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company         Company   @relation(fields: [companyId], references: [id])
  priceLists      PriceListItem[]
  inventoryItems  InventoryItem[]

  @@index([companyId])
  @@index([category])
  @@index([hsCode])
  @@map("products")
}

model PriceList {
  id          String    @id @default(cuid())
  companyId   Int
  name        String
  currency    String    @default("IRR")
  validFrom   DateTime
  validUntil  DateTime?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  company     Company   @relation(fields: [companyId], references: [id])
  items       PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id           Int       @id @default(autoincrement())
  priceListId  String
  productId    String
  unitPrice    Decimal   @db.Decimal(20, 2)
  minQty       Decimal?  @db.Decimal(15, 3)
  maxQty       Decimal?  @db.Decimal(15, 3)
  discount     Decimal?  @db.Decimal(5, 2)

  priceList    PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id])

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

// ══════════════════════════════════════════════
// TRADING MODULE
// ══════════════════════════════════════════════

model TradeRequest {
  id              String        @id @default(cuid())
  buyerCompanyId  Int
  sellerCompanyId Int?
  product         String
  qty             Decimal       @db.Decimal(15, 3)
  unit            String
  targetPrice     Decimal?      @db.Decimal(20, 2)
  amountIRR       BigInt?
  currency        String        @default("IRR")
  status          RequestStatus @default(PENDING)
  priority        Priority      @default(NORMAL)
  deadline        DateTime?
  note            String?
  hsCode          String?
  deliveryAddress String?
  incoterm        String?
  paymentTerms    String?
  qualitySpec     String?
  sampleRequired  Boolean       @default(false)
  havNo           String?
  issuedAt        DateTime?
  createdById     Int
  assignedToId    Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  buyerCompany    Company       @relation("BuyerCompany", fields: [buyerCompanyId], references: [id])
  sellerCompany   Company?      @relation("SellerCompany", fields: [sellerCompanyId], references: [id])
  createdBy       User          @relation(fields: [createdById], references: [id])
  quotes          Quote[]
  contract        Contract?
  invoice         Invoice?
  shipment        Shipment?
  qualityChecks   QualityCheck[]
  disputes        Dispute[]
  followUps       FollowUp[]
  attachments     Attachment[]  @relation("RequestAttachments")

  @@index([buyerCompanyId])
  @@index([sellerCompanyId])
  @@index([status])
  @@index([createdAt])
  @@map("trade_requests")
}

model Quote {
  id              String    @id @default(cuid())
  requestId       String
  sellerCompanyId Int
  unitPrice       Decimal   @db.Decimal(20, 2)
  currency        String    @default("IRR")
  totalPrice      Decimal   @db.Decimal(20, 2)
  vatAmount       Decimal?  @db.Decimal(20, 2)
  validUntil      DateTime?
  deliveryDays    Int?
  deliveryAddress String?
  incoterm        String?
  paymentTerms    String?
  note            String?
  status          BidStatus @default(PENDING)
  rejectionReason String?
  createdById     Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  request         TradeRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@index([sellerCompanyId])
  @@map("quotes")
}

model Contract {
  id              String         @id @default(cuid())
  requestId       String         @unique
  contractNo      String?        @unique
  buyerCompanyId  Int
  sellerCompanyId Int
  title           String
  amountIRR       BigInt
  currency        String         @default("IRR")
  status          ContractStatus @default(DRAFT)
  signedBuyer     Boolean        @default(false)
  signedSeller    Boolean        @default(false)
  signedBuyerAt   DateTime?
  signedSellerAt  DateTime?
  startDate       DateTime?
  endDate         DateTime?
  deliveryDate    DateTime?
  terms           String?
  penaltyClause   String?
  warrantyMonths  Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  request         TradeRequest   @relation(fields: [requestId], references: [id])
  buyerCompany    Company        @relation("BuyerContract", fields: [buyerCompanyId], references: [id])
  sellerCompany   Company        @relation("SellerContract", fields: [sellerCompanyId], references: [id])
  attachments     Attachment[]   @relation("ContractAttachments")

  @@index([buyerCompanyId])
  @@index([sellerCompanyId])
  @@map("contracts")
}

model Tender {
  id              String       @id @default(cuid())
  type            TenderType
  title           String
  description     String?
  companyId       Int
  startDate       DateTime
  endDate         DateTime
  awardDate       DateTime?
  status          TenderStatus @default(DRAFT)
  isPublic        Boolean      @default(true)
  requireBond     Boolean      @default(false)
  bondAmount      Decimal?     @db.Decimal(20, 2)
  currency        String       @default("IRR")
  createdById     Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company         Company      @relation(fields: [companyId], references: [id])
  products        TenderProduct[]
  bids            Bid[]
  blacklist       TenderBlacklist[]

  @@index([companyId])
  @@index([status])
  @@map("tenders")
}

model TenderProduct {
  id          Int       @id @default(autoincrement())
  tenderId    String
  name        String
  qty         Decimal   @db.Decimal(15, 3)
  unit        String
  currency    String    @default("IRR")
  basePrice   Decimal?  @db.Decimal(20, 2)
  minPrice    Decimal?  @db.Decimal(20, 2)
  maxPrice    Decimal?  @db.Decimal(20, 2)
  specs       String?

  tender      Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@map("tender_products")
}

model Bid {
  id          String    @id @default(cuid())
  tenderId    String
  bidderId    Int
  companyId   Int
  totalPrice  Decimal   @db.Decimal(20, 2)
  currency    String    @default("IRR")
  note        String?
  status      BidStatus @default(PENDING)
  submittedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tender      Tender    @relation(fields: [tenderId], references: [id])

  @@index([tenderId])
  @@index([companyId])
  @@map("bids")
}

model TenderBlacklist {
  id            Int       @id @default(autoincrement())
  tenderId      String
  companyId     Int
  reason        String?
  createdAt     DateTime  @default(now())

  tender        Tender    @relation(fields: [tenderId], references: [id])

  @@unique([tenderId, companyId])
  @@map("tender_blacklist")
}

model CompanyConnection {
  id           Int       @id @default(autoincrement())
  companyAId   Int
  companyBId   Int
  type         String    @default("partner")
  status       String    @default("active")
  rating       Int?
  notes        String?
  connectedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  companyA     Company   @relation("CompanyA", fields: [companyAId], references: [id])
  companyB     Company   @relation("CompanyB", fields: [companyBId], references: [id])

  @@unique([companyAId, companyBId])
  @@index([companyAId])
  @@index([companyBId])
  @@map("company_connections")
}

model InviteCode {
  id          Int       @id @default(autoincrement())
  companyId   Int
  code        String    @unique
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  note        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  company     Company   @relation(fields: [companyId], references: [id])

  @@map("invite_codes")
}

model FollowUp {
  id          String    @id @default(cuid())
  requestId   String
  userId      Int
  note        String
  nextDate    DateTime?
  isDone      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  request     TradeRequest @relation(fields: [requestId], references: [id])

  @@map("follow_ups")
}

model QualityCheck {
  id           String    @id @default(cuid())
  requestId    String
  inspectorId  Int?
  inspectorName String?
  result       String
  score        Decimal?  @db.Decimal(5, 2)
  note         String?
  checkedAt    DateTime  @default(now())
  createdAt    DateTime  @default(now())

  request      TradeRequest @relation(fields: [requestId], references: [id])

  @@map("quality_checks")
}

model Dispute {
  id          String    @id @default(cuid())
  requestId   String
  raisedById  Int
  subject     String
  description String
  status      String    @default("open")
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  request     TradeRequest @relation(fields: [requestId], references: [id])
  messages    DisputeMessage[]

  @@map("disputes")
}

model DisputeMessage {
  id          Int       @id @default(autoincrement())
  disputeId   String
  senderId    Int
  message     String
  createdAt   DateTime  @default(now())

  dispute     Dispute   @relation(fields: [disputeId], references: [id])

  @@map("dispute_messages")
}

model Shipment {
  id              String         @id @default(cuid())
  requestId       String         @unique
  trackingNo      String?
  carrier         String?
  origin          String?
  destination     String?
  estimatedDate   DateTime?
  actualDate      DateTime?
  status          ShipmentStatus @default(BOOKED)
  weight          Decimal?       @db.Decimal(10, 3)
  volume          Decimal?       @db.Decimal(10, 3)
  containers      String?
  incoterm        String?
  waybillNo       String?
  customsRef      String?
  insuranceRef    String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  request         TradeRequest   @relation(fields: [requestId], references: [id])
  stages          ShipmentStage[]

  @@map("shipments")
}

model ShipmentStage {
  id          Int       @id @default(autoincrement())
  shipmentId  String
  key         String
  label       String
  date        String?
  note        String?
  isDone      Boolean   @default(false)
  order       Int       @default(0)

  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("shipment_stages")
}

// ══════════════════════════════════════════════
// FINANCE MODULE
// ══════════════════════════════════════════════

model Invoice {
  id              String        @id
  invoiceType     InvoiceType   @default(TYPE1)
  sellerCompanyId Int
  buyerCompanyId  Int
  requestId       String?       @unique
  invoiceNo       String?       @unique
  subtotal        BigInt
  discountTotal   BigInt        @default(0)
  vatAmount       BigInt
  tolAmount       BigInt
  taxAmount       BigInt
  total           BigInt
  paid            BigInt        @default(0)
  remaining       BigInt        @default(0)
  status          InvoiceStatus @default(DRAFT)
  currency        String        @default("IRR")
  exchangeRate    Decimal?      @db.Decimal(15, 4)
  issuedAt        String
  dueAt           String?
  paidAt          DateTime?
  note            String?
  taxSerial       String?
  taxSystemRef    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sellerCompany   Company       @relation("SellerInvoice", fields: [sellerCompanyId], references: [id])
  buyerCompany    Company       @relation("BuyerInvoice", fields: [buyerCompanyId], references: [id])
  request         TradeRequest? @relation(fields: [requestId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]
  attachments     Attachment[]  @relation("InvoiceAttachments")

  @@index([sellerCompanyId])
  @@index([buyerCompanyId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id            Int       @id @default(autoincrement())
  invoiceId     String
  row           Int
  desc          String
  qty           Decimal   @db.Decimal(15, 3)
  unit          String
  unitPrice     BigInt
  discount      BigInt    @default(0)
  discountPct   Decimal   @db.Decimal(5, 2) @default(0)
  netPrice      BigInt
  subtotalRow   BigInt
  taxPct        Decimal   @db.Decimal(5, 2) @default(10)
  vatPct        Decimal   @db.Decimal(5, 2) @default(9)
  tolPct        Decimal   @db.Decimal(5, 2) @default(1)
  vatAmount     BigInt
  tolAmount     BigInt
  taxAmount     BigInt
  totalRow      BigInt
  hsCode        String?
  productId     String?

  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

// ── Quotations (Proforma) ─────────────────────
model Quotation {
  id              String    @id @default(cuid())
  quotationNo     String?   @unique
  sellerCompanyId Int
  buyerCompanyId  Int
  requestId       String?
  items           Json
  subtotal        BigInt
  vatAmount       BigInt
  taxAmount       BigInt
  total           BigInt
  currency        String    @default("IRR")
  validUntil      DateTime?
  note            String?
  status          String    @default("draft")
  createdAt       DateTime  @default(now())

  @@index([sellerCompanyId])
  @@index([buyerCompanyId])
  @@map("quotations")
}

// ── Payments ──────────────────────────────────
model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  amount          BigInt
  currency        String        @default("IRR")
  method          PaymentMethod
  referenceNo     String?
  bankName        String?
  accountNo       String?
  paidAt          DateTime
  note            String?
  confirmedById   Int?
  confirmedAt     DateTime?
  createdAt       DateTime      @default(now())

  invoice         Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("payments")
}

// ── Accounting ────────────────────────────────
model Account {
  id          Int         @id @default(autoincrement())
  code        String
  name        String
  nameFa      String?
  type        AccountType
  parentId    Int?
  companyId   Int
  balance     BigInt      @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  parent      Account?    @relation("AccountTree", fields: [parentId], references: [id])
  children    Account[]   @relation("AccountTree")
  debitLines  JournalLine[] @relation("DebitAccount")
  creditLines JournalLine[] @relation("CreditAccount")
  company     Company     @relation(fields: [companyId], references: [id])

  @@unique([code, companyId])
