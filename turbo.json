{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV","DATABASE_URL","JWT_SECRET","NEXT_PUBLIC_API_URL"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**","dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "test": { "dependsOn": ["build"] }
  }
}
